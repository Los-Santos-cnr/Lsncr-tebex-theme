# ── Required: catalog + cart ──
NEXT_PUBLIC_TEBEX_PUBLIC_TOKEN=
TEBEX_PRIVATE_KEY=
NEXT_PUBLIC_SITE_URL=https://store.lscnr.net

# ── Optional: marketing ──
NEXT_PUBLIC_PROMO_CODE=
# Optional. If empty, the top banner uses active Tebex sale names (needs TEBEX_SECRET_KEY).
NEXT_PUBLIC_PROMO_BANNER=
NEXT_PUBLIC_HERO_IMAGE=
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/lscnr

# Discord OAuth for VIP / unban (https://discord.com/developers/applications)
# Add these redirect URLs on the app: http://localhost:3000/api/discord/callback
# and https://store.lscnr.net/api/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_SALE_ENDS_AT=
NEXT_PUBLIC_FIVEM_CONNECT_URL=
NEXT_PUBLIC_MAIN_SITE_URL=

# ── Order history (Vercel Postgres) ──
POSTGRES_URL=
TEBEX_WEBHOOK_SECRET=

# ── Admin panel (/admin) and Top Supporters ranking ──
# Leave ADMIN_PASSWORD blank to disable /admin. TEBEX_SECRET_KEY also ranks /supporters
# and overlays live sale prices/tags on the storefront (Headless does not send them).
TEBEX_SECRET_KEY=
ADMIN_PASSWORD=

# ── Top Supporters names (UCP lookup, server-side only) ──
STORE_PLAYER_LOOKUP_KEY=
STORE_PLAYER_LOOKUP_URL=https://ucp.lscnr.net
